{
  "name": "aia-kit",
  "version": "2.0.0",
  "description": "Read, inspect, edit, check and write App Inventor / Kodular projects (AIA) and extensions (AIX).",
  "keywords": [
    "aia",
    "aix",
    "app-inventor",
    "blockly",
    "extension",
    "kodular"
  ],
  "license": "ISC",
  "author": "Kodular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kodular/aia-kit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./platforms": "./dist/platforms.js",
    "./analysis": "./dist/analysis.js",
    "./formats": "./dist/formats.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm run typecheck && pnpm --filter @aia-kit/explorer typecheck && pnpm run lint && pnpm run fmt:check && pnpm run test",
    "explorer": "pnpm --filter @aia-kit/explorer dev"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "@zip.js/zip.js": "^2.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
