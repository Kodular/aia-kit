{
  "name": "aia-kit",
  "version": "1.1.2",
  "description": "Read, Parse, Edit, Write, Analyze AIA/AIX/AIS files.",
  "keywords": [
    "app-inventor",
    "kodular",
    "aia",
    "aix",
    "ais",
    "extension"
  ],
  "author": "Kodular",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kodular/aia-kit.git"
  },
  "type": "module",
  "module": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./aia": "./dist/src/aia/index.js",
    "./ais": "./dist/src/ais/index.js",
    "./aix": "./dist/src/aix/index.js",
    "./analysis": "./dist/src/analysis/index.js",
    "./bky": "./dist/src/bky/index.js",
    "./component-descriptor": "./dist/src/component-descriptor/index.js",
    "./environment": "./dist/src/environment/index.js",
    "./model": "./dist/src/model/index.js",
    "./project-properties": "./dist/src/project-properties/index.js",
    "./scm": "./dist/src/scm/index.js",
    "./yail": "./dist/src/yail/index.js"
  },
  "imports": {
    "#/*": {
      "types": "./src/*",
      "development": "./src/*",
      "default": "./dist/src/*"
    }
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "dist/environments"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && cp -r environments dist/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.5",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "@zip.js/zip.js": "^2.8.26",
    "properties-file": "^5.0.4",
    "zod": "^4.4.1"
  }
}
