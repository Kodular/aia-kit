{
  "name": "aia-kit",
  "version": "1.1.2",
  "description": "Read, Parse, Edit, Write, Analyze AIA/AIX/AIS files.",
  "keywords": [
    "aia",
    "ais",
    "aix",
    "app-inventor",
    "extension",
    "kodular"
  ],
  "license": "ISC",
  "author": "Kodular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kodular/aia-kit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "imports": {
    "#/*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./aia": "./dist/aia/index.mjs",
    "./ais": "./dist/ais/index.mjs",
    "./aix": "./dist/aix/index.mjs",
    "./analysis": "./dist/analysis/index.mjs",
    "./bky": "./dist/bky/index.mjs",
    "./component-descriptor": "./dist/component-descriptor/index.mjs",
    "./environment": "./dist/environment/index.mjs",
    "./model": "./dist/model/index.mjs",
    "./project-properties": "./dist/project-properties/index.mjs",
    "./scm": "./dist/scm/index.mjs",
    "./yail": "./dist/yail/index.mjs"
  },
  "scripts": {
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt:apply": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "@zip.js/zip.js": "^2.8.26",
    "properties-file": "^5.0.4",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.5",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
